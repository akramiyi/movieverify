# MovieVerify Telegram Bot — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to GitHub.

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs that have admin access
# Find your ID by messaging @userinfobot on Telegram
TELEGRAM_ADMIN_IDS=

# Supabase project URL (same as your website's VITE_SUPABASE_URL)
SUPABASE_URL=

# Supabase SERVICE ROLE key (NOT the anon key!)
# Find in Supabase Dashboard → Settings → API → service_role key
# WARNING: This key bypasses RLS. Never expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=

# TMDB Read Access Token (same token as website, without VITE_ prefix)
TMDB_TOKEN=
