# ==========================================
# MovieVerify Environment Configuration Reference
# ==========================================

# 1. Supabase Client (Public Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. TMDB API (Frontend)
VITE_TMDB_TOKEN=your-tmdb-read-access-token

# 3. Server-Side Site Lock Secrets (DO NOT EXPOSE TO FRONTEND OR VITE_)
# Used exclusively in /api/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SITE_LOCK_SESSION_SECRET=replace-with-at-least-32-byte-cryptographically-random-secret
