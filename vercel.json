{
  "crons": [
    {
      "path": "/api/notifications/dispatch",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/share/:type/:id",
      "destination": "/api/share?type=:type&id=:id"
    },
    {
      "source": "/share/:type/:id/",
      "destination": "/api/share?type=:type&id=:id"
    },
    {
      "source": "/((?!api/|share/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
