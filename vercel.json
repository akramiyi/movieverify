{
  "crons": [
    {
      "path": "/api/notifications/dispatch",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/notifications/dispatch.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/home-feed",
      "destination": "/api/share?feed=home"
    },
    {
      "source": "/share/:type/:id",
      "destination": "/api/share?type=:type&id=:id"
    },
    {
      "source": "/share/:type/:id/",
      "destination": "/api/share?type=:type&id=:id"
    },
    {
      "source": "/((?!api/|share/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
